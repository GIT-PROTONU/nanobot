[Unit]
Description=Nano navigation (ONE container: Nav2 servers + lifecycle manager)
# After sensors so /odom + /scan are flowing before the container loads the
# components (the component attach itself is the nav-loader unit's job, below).
After=nano-router.service nano-sensors.service
Wants=nano-router.service
PartOf=nano-robot.target

[Service]
Type=simple
User=ibster
ExecStart=/home/ibster/Nano/scripts/unit_exec.sh nav
Restart=on-failure
RestartSec=3
# CPU/RAM guard for Ceres's HARDCODED 50-thread spike (no ceres_num_threads
# param exists upstream) + pose-graph growth on the 1 GB H5: keep nav off the
# cores the sensor/app hubs live on and deprioritise it under contention.
# MALLOC_ARENA_MAX=2 is already set inside unit_exec.sh.
CPUAffinity=2 3
Nice=10
MemoryMax=400M

[Install]
WantedBy=nano-robot.target
